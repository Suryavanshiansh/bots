# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your Telegram User ID (gives you Owner Superuser access to view all whispers)
OWNER_ID=YOUR_TELEGRAM_USER_ID_HERE

# Supabase PostgreSQL Connection String (Optional, defaults to local SQLite whispers.db if not set)
# Get from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
